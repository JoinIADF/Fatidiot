+function updateDartHud() {
+  const hud = document.getElementById("dartHud");
+  const line = document.getElementById("dartScoreLine");
+  if (!dartGame.active) {
+    if (hud) hud.classList.remove("show");
+    return;
+  }
+  if (hud) hud.classList.add("show");
+  let html = "";
+  if (dartGame.mode === "201") {
+    html = `<b>201</b> · remaining <b>${dartGame.score201}</b> · turn darts ${dartGame.dartsThisTurn}`;
+  } else if (dartGame.mode === "cricket") {
+    const m = dartGame.cricket.marks;
+    const bits = [20,19,18,17,16,15,25].map(n => {
+      const v = m[n] || 0;
+      const dots = "●".repeat(Math.min(3, v)) + "○".repeat(Math.max(0, 3 - v));
+      return `${n === 25 ? "B" : n}:${dots}`;
+    });
+    html = `<b>CRICKET</b> · pts <b>${dartGame.cricket.points}</b><br>${bits.join(" · ")}`;
+  } else {
+    html = `<b>PRACTICE</b> · score <b>${dartGame.total}</b> · left ${dartGame.throwsLeft}`;
+  }
+  if (hud) hud.innerHTML = html;
+  if (line) line.textContent = dartGame.mode === "201"
+    ? `${dartGame.score201} left`
+    : dartGame.mode === "cricket"
+      ? `${dartGame.cricket.points} pts`
+      : `${dartGame.total} pts`;

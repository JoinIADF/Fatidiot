+function countPeopleOnDanceFloor(L) {
+  if (!L || !L.danceFloor || !pig) return 0;
+  const d = L.danceFloor;
+  const hw = d.halfW, hd = d.halfD, cx = d.center.x, cz = d.center.z;
+  const on = (x, z) => Math.abs(x - cx) <= hw && Math.abs(z - cz) <= hd;
+  let n = 0;
+  if (on(pig.position.x, pig.position.z)) n++;
+  try {
+    for (const e of enemies) {
+      if (!e || e.type !== "xuser" || !e.mesh) continue;
+      if (on(e.mesh.position.x, e.mesh.position.z)) n++;
+    }
+  } catch (_) {}
+  try {
+    if (typeof MP !== "undefined" && MP && MP.remotes) {
+      for (const r of MP.remotes.values()) {
+        if (r && r.mesh && on(r.mesh.position.x, r.mesh.position.z)) n++;
+      }
+    }
+  } catch (_) {}
+  return n;
+}
+function playDanceBeat() {
+  try {
+    const bass = [110, 110, 165, 110, 98, 110, 131, 110];
+    const lead = [330, 392, 440, 392, 494, 440, 392, 330];
+    bass.forEach((f, i) => setTimeout(() => {
+      try { thump(f, 0.1, 0.12); beep(f * 2, 0.08, "square", 0.035); } catch (_) {}
+    }, i * 140));
+    lead.forEach((f, i) => setTimeout(() => {
+      try { beep(f, 0.1, "triangle", 0.045); } catch (_) {}
+    }, i * 140 + 40));
+  } catch (_) {}
+}
+function updateDanceFloorParty(dt) {
+  const L = loungeDecor && loungeDecor.userData;
+  if (!L || !L.danceFloor) return;
+  const d = L.danceFloor;
+  const n = countPeopleOnDanceFloor(L);
+  const want = n >= 3;
+  if (want && !d.party) {
+    d.party = true;
+    try { showMsg("♪ DANCE PARTY · " + n + " on the floor"); } catch (_) {}
+    try { SFX.wave(); } catch (_) {}
+  } else if (!want && d.party) {
+    d.party = false;
+    if (d.mat) { d.mat.emissiveIntensity = 0.25; d.mat.emissive.setHex(0x2a1050); }
+    if (d.light) d.light.intensity = 0;
+  }
+  if (!d.party) return;
+  d.beatT = (d.beatT || 0) + dt;
+  d.musicT = (d.musicT || 0) - dt;
+  if (d.musicT <= 0) {
+    d.musicT = 1.15;
+    playDanceBeat();
+  }
+  const pulse = 0.55 + 0.55 * Math.abs(Math.sin(d.beatT * 8));
+  if (d.mat) {
+    d.mat.emissiveIntensity = 0.35 + pulse * 1.4;
+    d.mat.emissive.setHSL((d.beatT * 0.15) % 1, 0.85, 0.35);
+  }
+  if (d.light) {
+    d.light.intensity = 4 + pulse * 10;
+    d.light.color.setHSL((d.beatT * 0.22 + 0.4) % 1, 0.9, 0.55);
+  }
+}
+
+
 

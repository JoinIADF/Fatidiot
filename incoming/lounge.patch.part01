+function mkRaceCar(color) {
+  const car = new THREE.Group();
+  const body = new THREE.Mesh(
+    new THREE.BoxGeometry(0.75, 0.28, 1.15),
+    new THREE.MeshBasicMaterial({ color, toneMapped: false })
+  );
+  body.position.y = 0.22;
+  car.add(body);
+  const cabin = new THREE.Mesh(
+    new THREE.BoxGeometry(0.55, 0.22, 0.55),
+    new THREE.MeshBasicMaterial({ color: 0x0a1520, toneMapped: false })
+  );
+  cabin.position.set(0, 0.42, -0.05);
+  car.add(cabin);
+  for (const [wx, wz] of [[-0.38, 0.35], [0.38, 0.35], [-0.38, -0.4], [0.38, -0.4]]) {
+    const wh = new THREE.Mesh(
+      new THREE.CylinderGeometry(0.14, 0.14, 0.12, 10),
+      new THREE.MeshBasicMaterial({ color: 0x111418, toneMapped: false })
+    );
+    wh.rotation.z = Math.PI / 2;
+    wh.position.set(wx, 0.14, wz);
+    car.add(wh);
+  }
+  car.traverse(o => { if (o.isMesh) { o.layers.set(1); o.frustumCulled = false; } });
+  car.layers.set(1);
+  return car;

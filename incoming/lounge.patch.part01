+function racePoly(ctx, x1, y1, x2, y2, x3, y3, x4, y4, color) {
+  ctx.fillStyle = color;
+  ctx.beginPath();
+  ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.lineTo(x3, y3); ctx.lineTo(x4, y4);
+  ctx.closePath(); ctx.fill();
+}
+function raceSegment(ctx, width, lanes, x1, y1, w1, x2, y2, w2, color) {
+  const r1 = w1 / Math.max(6, 2 * lanes), r2 = w2 / Math.max(6, 2 * lanes);
+  const l1 = w1 / Math.max(32, 8 * lanes), l2 = w2 / Math.max(32, 8 * lanes);
+  ctx.fillStyle = color.grass;
+  ctx.fillRect(0, y2, width, y1 - y2);
+  racePoly(ctx, x1 - w1 - r1, y1, x1 - w1, y1, x2 - w2, y2, x2 - w2 - r2, y2, color.rumble);
+  racePoly(ctx, x1 + w1 + r1, y1, x1 + w1, y1, x2 + w2, y2, x2 + w2 + r2, y2, color.rumble);
+  racePoly(ctx, x1 - w1, y1, x1 + w1, y1, x2 + w2, y2, x2 - w2, y2, color.road);
+  if (color.lane) {
+    const lanew1 = w1 * 2 / lanes, lanew2 = w2 * 2 / lanes;
+    let lanex1 = x1 - w1 + lanew1, lanex2 = x2 - w2 + lanew2;
+    for (let lane = 1; lane < lanes; lanex1 += lanew1, lanex2 += lanew2, lane++)
+      racePoly(ctx, lanex1 - l1 / 2, y1, lanex1 + l1 / 2, y1, lanex2 + l2 / 2, y2, lanex2 - l2 / 2, y2, color.lane);
+  }
+}
+function raceDrawCar(ctx, x, y, scale, color, name, steer) {
+  const w = 80 * scale, h = 40 * scale;
+  ctx.save();
+  ctx.translate(x, y);
+  /* body */
+  ctx.fillStyle = color;
+  ctx.beginPath();
+  ctx.moveTo(-w * 0.45, -h * 0.1);
+  ctx.lineTo(-w * 0.35, -h * 0.55);
+  ctx.lineTo(w * 0.35, -h * 0.55);
+  ctx.lineTo(w * 0.45, -h * 0.1);
+  ctx.lineTo(w * 0.4, h * 0.35);
+  ctx.lineTo(-w * 0.4, h * 0.35);
+  ctx.closePath();
+  ctx.fill();
+  /* windshield */
+  ctx.fillStyle = "rgba(180,220,255,0.55)";
+  ctx.fillRect(-w * 0.22, -h * 0.48, w * 0.44, h * 0.22);
+  /* wheels */
+  ctx.fillStyle = "#111";
+  ctx.fillRect(-w * 0.42, h * 0.15, w * 0.16, h * 0.28);
+  ctx.fillRect(w * 0.26, h * 0.15, w * 0.16, h * 0.28);
+  /* name tag */
+  if (scale > 0.35) {
+    ctx.fillStyle = "rgba(0,0,0,0.65)";
+    const tw = Math.max(36, name.length * 7) * Math.min(1, scale);
+    ctx.fillRect(-tw / 2, -h * 0.95, tw, 14 * Math.min(1.2, scale));
+    ctx.fillStyle = "#fff";
+    ctx.font = "bold " + Math.round(11 * Math.min(1.2, scale)) + "px system-ui";
+    ctx.textAlign = "center";
+    ctx.fillText(name, 0, -h * 0.95 + 11 * Math.min(1.2, scale));
+  }
+  ctx.restore();
+}
+function raceCollectRacers() {
+  const youName = (typeof MP !== "undefined" && MP && MP.displayName) ? MP.displayName : "You";
+  const colors = ["#1d9bf0", "#ff6a4a", "#7CFFB0", "#d48cff"];
+  const list = [{ name: youName, color: colors[0], isYou: true, isP2: false, ai: false }];
+  /* optional local P2 always available on same screen */
+  list.push({ name: "P2", color: colors[1], isYou: false, isP2: true, ai: false });
+  /* guests from multiplayer if present */
+  let guestN = 0;
+  try {
+    if (typeof MP !== "undefined" && MP && MP.remotes) {
+      for (const r of MP.remotes.values()) {
+        if (list.length >= 4) break;
+        const nm = (r.player && (r.player.getProfile?.()?.name || r.player.id)) || ("Guest" + (++guestN));
+        list.push({ name: String(nm).slice(0, 12), color: colors[list.length % colors.length], isYou: false, isP2: false, ai: true });
+      }
+    }
+  } catch (_) {}
+  while (list.length < 4) {
+    list.push({ name: "AI-" + list.length, color: colors[list.length % colors.length], isYou: false, isP2: false, ai: true });
+  }
+  return list.slice(0, 4).map((r, i) => ({
+    ...r,
+    x: -0.45 + i * 0.3,
+    z: i * raceGame.segLen * 2,
+    speed: 0,
+    lap: 1,
+    finished: false,
+    place: 0,
+  }));
 }

+function dartOnLoungeLayer(obj) {
+  /* Live lounge camera is locked to layer 1 — anything left on 0 is invisible */
+  if (!obj) return;
+  try {
+    obj.layers.set(1);
+    obj.traverse(o => {
+      o.layers.set(1);
+      if (o.isMesh || o.isSprite || o.isLine) {
+        o.frustumCulled = false;
+        o.visible = true;
+      }
+    });
+  } catch (_) {}
+}
+function forceHideLoungeControls() {
+  document.body.classList.add("darts-active", "reading-tweets");
+  const hideIds = [
+    "mobileUI", "loungeMobBar", "stickBase", "stickZone", "btnCol",
+    "mJump", "mAdd", "mBoom", "mSwap", "mRifle", "stickLockLabel",
+    "mobileHint", "socialHint", "crosshair", "guestChip", "zoneTag",
+    "sitHint", "wave", "score", "weapon", "portalHint", "lockBracket"
+  ];
+  for (const id of hideIds) {
+    const el = document.getElementById(id);
+    if (!el) continue;
+    el.classList.remove("show");
+    el.style.setProperty("display", "none", "important");
+    el.style.setProperty("visibility", "hidden", "important");
+    el.style.setProperty("opacity", "0", "important");
+    el.style.setProperty("pointer-events", "none", "important");
+  }
+  /* also kill any leftover .mbtn / lounge bar via class */
+  try {
+    document.querySelectorAll("#loungeMobBar, #mobileUI, #btnCol, #stickZone, #stickBase").forEach(el => {
+      el.style.setProperty("display", "none", "important");
+    });
+  } catch (_) {}
+}

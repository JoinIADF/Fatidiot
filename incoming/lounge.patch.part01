+function raceAddSegment(curve, y) {
+  const n = raceGame.segments.length;
+  raceGame.segments.push({
+    index: n, curve, sprites: [],
+    p1: { world: { y: raceLastY(), z: n * raceGame.segLen }, camera: {}, screen: {} },
+    p2: { world: { y: y, z: (n + 1) * raceGame.segLen }, camera: {}, screen: {} },
+    color: Math.floor(n / raceGame.rumble) % 2
+      ? { road: "#3a3f4a", grass: "#1a3a22", rumble: "#e8eef8", lane: "#ffffff" }
+      : { road: "#2a2e38", grass: "#14301c", rumble: "#d02020", lane: "#ffffff" },
+  });
+}
+function raceAddRoad(enter, hold, leave, curve, y) {
+  const startY = raceLastY();
+  const endY = startY + (y || 0) * raceGame.segLen;
+  const total = enter + hold + leave;
+  for (let n = 0; n < enter; n++)
+    raceAddSegment(curve * (n / enter), startY + (endY - startY) * (n / total));
+  for (let n = 0; n < hold; n++)
+    raceAddSegment(curve, startY + (endY - startY) * ((enter + n) / total));
+  for (let n = 0; n < leave; n++)
+    raceAddSegment(curve * (1 - n / leave), startY + (endY - startY) * ((enter + hold + n) / total));
+}

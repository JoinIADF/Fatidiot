+
+/* ============================================================
+   MULTIPLAYER LOUNGE — Playroom Kit (zero-server WebRTC sync)
+   Guests: unverified, name picker, max 30, chat + group chat,
+   sit/sync/games presence, LIST is view-only demo for guests.
+   ============================================================ */
+const MP = {
+  MAX: 30,
+  active: false,
+  connecting: false,
+  displayName: "",
+  roomCode: "",
+  remotes: new Map(), /* id -> { player, mesh, last } */
+  chatLog: [],
+  dockLines: [],
+  syncT: 0,
+  isGuest: true, /* multiplayer joiners are always unverified guests for list permissions */
+  demoListOnly: true,
+};
+
+function mpPR() {
+  return (typeof window !== "undefined" && (window.Playroom || window.playroomkit)) || null;
+}
+
+function mpOpenJoinModal() {
+  const m = document.getElementById("mpJoinModal");
+  if (!m) return;
+  m.classList.remove("hidden");
+  m.setAttribute("aria-hidden", "false");
+  const name = document.getElementById("mpName");
+  const err = document.getElementById("mpjErr");
+  if (err) err.textContent = "";
+  if (name) {
+    try {
+      name.value = localStorage.getItem("fatidiot_mp_name") || "";
+    } catch (_) {}
+    setTimeout(() => { try { name.focus(); } catch (_) {} }, 50);
+  }
+}
+
+function mpCloseJoinModal() {
+  const m = document.getElementById("mpJoinModal");
+  if (!m) return;
+  m.classList.add("hidden");
+  m.setAttribute("aria-hidden", "true");
+}

+/** Map hit offset on board plane → sector score {mult, num, pts, label} */
+function scoreDartHit(offY, offZ, R) {
+  const r = Math.hypot(offY, offZ) / Math.max(0.001, R);
+  if (r > 1.02) return { mult: 0, num: 0, pts: 0, label: "MISS" };
+  if (r <= 0.08) return { mult: 2, num: 25, pts: 50, label: "BULL 50" };
+  if (r <= 0.16) return { mult: 1, num: 25, pts: 25, label: "25" };
+  /* angle: board faces -X; local up = Y, local right on face = -Z (when looking at board from -X) */
+  let ang = Math.atan2(offZ, offY); /* 0 = up */
+  ang = (ang + Math.PI * 2) % (Math.PI * 2);
+  /* sectors start at top (20), go clockwise: SECTORS index 5 is 20 at top */
+  /* our SECTORS[0]=6 is at right of top in standard... map: 0 at top = 20 */
+  const sectorAng = (ang + Math.PI / 20) % (Math.PI * 2);
+  let idx = Math.floor(sectorAng / (Math.PI / 10)) % 20;
+  /* remap so 0 (up) = 20 which is SECTORS index 5 */
+  idx = (idx + 5) % 20;
+  const num = DART_SECTORS[idx];
+  let mult = 1;
+  if (r >= 0.90 && r <= 1.02) mult = 2;
+  else if (r >= 0.55 && r <= 0.62) mult = 3;
+  const pts = num * mult;
+  const label = mult === 3 ? `T${num}` : mult === 2 ? `D${num}` : `${num}`;
+  return { mult, num, pts, label };
+}
+function applyDartScore(hit) {
+  if (dartGame.mode === "practice") {
+    dartGame.total += hit.pts;
+    return hit.label + (hit.pts ? ` +${hit.pts}` : "");
+  }
+  if (dartGame.mode === "201") {
+    if (hit.pts === 0) return "MISS";
+    const next = dartGame.score201 - hit.pts;
+    /* bust rules: below 0, or to 1, or to 0 without double */
+    if (next < 0 || next === 1) return `BUST (${hit.label})`;
+    if (next === 0) {
+      if (hit.mult !== 2 && !(hit.num === 25 && hit.mult === 2)) return `BUST · need double`;
+      dartGame.score201 = 0;
+      dartGame.total += hit.pts;
+      return `CHECKOUT ${hit.label}!`;
+    }
+    dartGame.score201 = next;
+    dartGame.total += hit.pts;
+    return `${hit.label} → ${next}`;
+  }
+  /* cricket */
+  const c = dartGame.cricket;
+  const n = hit.num;
+  if (![15,16,17,18,19,20,25].includes(n) || hit.pts === 0) return hit.label || "MISS";
+  const marksToAdd = hit.num === 25 ? (hit.mult >= 2 ? 2 : 1) : hit.mult;
+  let added = 0;
+  let points = 0;
+  for (let i = 0; i < marksToAdd; i++) {
+    if (c.marks[n] < 3) c.marks[n]++;
+    else { points += n; c.points += n; }
+    added++;
+  }
+  dartGame.total = c.points;
+  return `${hit.label} · ${c.marks[n]}/3` + (points ? ` +${points}` : "");

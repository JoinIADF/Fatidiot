-const liveTV = {
-  active: false, tuners: [], remotes: [], heldRemote: null,
-  captions: true, audioTV: null, frameSkip: 0,
-};
-function ensureHlsJs() {
-  return new Promise((resolve, reject) => {
-    if (window.Hls) { resolve(window.Hls); return; }
-    const sc = document.createElement("script");
-    sc.src = "https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js";
-    sc.onload = () => window.Hls ? resolve(window.Hls) : reject(new Error("no Hls global"));
-    sc.onerror = () => reject(new Error("hls.js CDN load failed"));
-    document.head.appendChild(sc);
-  });
-}
-function liveTVActiveCue(t) {
-  try {
-    const tracks = t.video.textTracks;
-    for (let i = 0; i < tracks.length; i++) {
-      const tr = tracks[i];
-      if (tr.kind !== "captions" && tr.kind !== "subtitles") continue;
-      if (tr.mode === "disabled") tr.mode = "hidden";
-      const cues = tr.activeCues;
-      if (cues && cues.length) {
-        let txt = "";
-        for (let c = 0; c < cues.length; c++) txt += (c ? " " : "") + (cues[c].text || "");
-        return txt.replace(/<[^>]+>/g, "").trim();
-      }
-    }
-  } catch (_) {}
-  return "";
-}
-function liveTVDrawFrame(t) {
-  return (ctx2, w, h) => {
-    const v = t.video;
-    ctx2.fillStyle = "#000"; ctx2.fillRect(0, 0, w, h);
-    if (v && v.readyState >= 2 && v.videoWidth) {
-      const ar = v.videoWidth / v.videoHeight, tar = w / h;
-      let dw = w, dh = h, dx = 0, dy = 0;
-      if (ar > tar) { dh = w / ar; dy = (h - dh) / 2; } else { dw = h * ar; dx = (w - dw) / 2; }
-      ctx2.drawImage(v, dx, dy, dw, dh);
-    }
-    /* closed captions */
-    if (liveTV.captions) {
-      const cue = liveTVActiveCue(t);
-      if (cue) {
-        ctx2.font = "bold 18px system-ui, sans-serif";
-        ctx2.textAlign = "center"; ctx2.textBaseline = "bottom";
-        /* naive 2-line wrap */
-        const words = cue.split(/\s+/);
-        const lines = [];
-        let cur = "";
-        for (const wd of words) {
-          const trial = cur ? cur + " " + wd : wd;
-          if (ctx2.measureText(trial).width > w - 60 && cur) { lines.push(cur); cur = wd; }
-          else cur = trial;
-        }
-        if (cur) lines.push(cur);
-        const show = lines.slice(-2);
-        let yy = h - 44;
-        for (let li = show.length - 1; li >= 0; li--) {
-          const tw = ctx2.measureText(show[li]).width;
-          ctx2.fillStyle = "rgba(0,0,0,0.75)";
-          ctx2.fillRect(w / 2 - tw / 2 - 8, yy - 22, tw + 16, 26);
-          ctx2.fillStyle = "#fff";
-          ctx2.fillText(show[li], w / 2, yy);
-          yy -= 28;
-        }
-      }
-    }
-    /* status strip */
-    ctx2.fillStyle = "rgba(0,0,0,0.62)";
-    ctx2.fillRect(0, h - 30, w, 30);
-    ctx2.fillStyle = "#ff3b3b";
-    ctx2.beginPath(); ctx2.arc(18, h - 15, 6, 0, Math.PI * 2); ctx2.fill();
-    ctx2.fillStyle = "#fff";
-    ctx2.font = "bold 15px system-ui, sans-serif";
-    ctx2.textAlign = "left"; ctx2.textBaseline = "middle";
-    ctx2.fillText("LIVE \u00b7 " + t.name + (liveTV.audioTV === t.idx ? "  \ud83d\udd0a" : ""), 32, h - 14);
-    ctx2.textAlign = "right";
-    ctx2.fillStyle = "#9ec4e0";
-    ctx2.font = "600 12px system-ui, sans-serif";
-    ctx2.fillText("TV-" + (t.idx + 1), w - 10, h - 14);
-  };
-}
-function liveTVTuneTV(idx, nextChannel, manual = false) {
-  const t = liveTV.tuners[idx];
-  if (!t || !liveTV.active) return;
-  t.playing = false;
-  if (nextChannel) {
-    t.chIdx = (t.chIdx + 1) % LIVE_TV_CHANNELS.length;
-    t.urlIdx = 0;
-  } else {
-    t.urlIdx++;
-    if (t.urlIdx >= LIVE_TV_CHANNELS[Math.max(0, t.chIdx)].urls.length) {
-      t.chIdx = (t.chIdx + 1) % LIVE_TV_CHANNELS.length;
-      t.urlIdx = 0;
-      t.hopCount = (t.hopCount || 0) + 1;
-      if (t.hopCount > LIVE_TV_CHANNELS.length) { t.dead = true; return; } /* full loop failed — rest */
-    }
-  }
-  const ch = LIVE_TV_CHANNELS[t.chIdx];
-  const url = ch.urls[t.urlIdx];
-  t.name = ch.name;
-  if (manual) { t.hopCount = 0; t.dead = false; try { showMsg("\ud83d\udcfa TV-" + (idx + 1) + " tuning: " + ch.name); } catch (_) {} }
-  const v = t.video;
-  try { if (t.hls) { t.hls.destroy(); t.hls = null; } } catch (_) {}
-  clearTimeout(t.watchdog);
-  const tick = () => {
-    if (document.hidden) { t.watchdog = setTimeout(tick, 4000); return; }
-    if (liveTV.active && !t.playing) liveTVTuneTV(idx, false);
-  };
-  t.watchdog = setTimeout(tick, 9000);
-  try {
-    if (v.canPlayType("application/vnd.apple.mpegurl")) {
-      v.src = url;
-      v.play().catch(() => {});
-    } else if (window.Hls && window.Hls.isSupported()) {
-      const h = new window.Hls({ enableWorker: true, maxBufferLength: 10 });
-      t.hls = h;
-      h.on(window.Hls.Events.MANIFEST_PARSED, () => {
-        /* cap quality ~480p per TV — four streams at once must stay light */
-        try {
-          let capIdx = -1;
-          (h.levels || []).forEach((lv, li) => { if (lv.height && lv.height <= 480) capIdx = li; });
-          if (capIdx >= 0) h.autoLevelCapping = capIdx;
-        } catch (_) {}
-      });
-      h.on(window.Hls.Events.ERROR, (_ev, data) => {
-        if (data && data.fatal && liveTV.active && !t.playing) {
-          try { h.destroy(); } catch (_) {}
-          if (t.hls === h) { t.hls = null; liveTVTuneTV(idx, false); }
-        }
-      });
-      h.loadSource(url);
-      h.attachMedia(v);
-      v.play().catch(() => {});
-    }
-  } catch (e) { liveTVTuneTV(idx, false); }
-}
-function liveTVBuildRemotes() {
-  if (liveTV.remotes.length || !loungeDecor) return;
-  /* four remotes along the (lowered) bar top: one per TV */
-  const spots = [[-16.5, -11.3], [-12.2, -11.3], [-7.8, -11.3], [-3.4, -11.3]];
-  for (let i = 0; i < 4; i++) {
-    const grp = new THREE.Group();
-    grp.name = "TVRemote_" + (i + 1);
-    const body = new THREE.Mesh(new THREE.BoxGeometry(0.13, 0.045, 0.32),
-      new THREE.MeshStandardMaterial({ color: 0x15171c, roughness: 0.5 }));
-    grp.add(body);
-    const btn = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.025, 0.015, 8),
-      new THREE.MeshBasicMaterial({ color: 0xd02020 }));
-    btn.position.set(0, 0.03, -0.1);
-    grp.add(btn);
-    for (let b = 0; b < 6; b++) {
-      const k = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.012, 0.03),
-        new THREE.MeshStandardMaterial({ color: 0x3a3f48 }));
-      k.position.set((b % 2) ? 0.03 : -0.03, 0.028, 0.02 + Math.floor(b / 2) * 0.07);
-      grp.add(k);
-    }
-    const tag = textSprite("TV-" + (i + 1), { size: 26, color: "#9ec4e0", strokeW: 5, maxWidth: 0 });
-    tag.scale.multiplyScalar(0.35);
-    tag.position.set(0, 0.35, 0);
-    tag.userData.maxDist = 10;
-    grp.add(tag);
-    grp.position.set(spots[i][0], 0.87, spots[i][1]);
-    grp.rotation.y = 0.4 - i * 0.25;
-    loungeDecor.add(grp);
-    liveTV.remotes.push({ idx: i, mesh: grp, tag, held: false });
-  }
-}
-async function startLoungeLiveTV() {
-  if (liveTV.active) return;
-  liveTV.active = true;
-  try {
-    try { await ensureHlsJs(); } catch (e) { console.warn("liveTV:", e.message); }
-    if (!liveTV.tuners.length) {
-      for (let i = 0; i < 4; i++) {
-        const v = document.createElement("video");
-        v.muted = true; v.playsInline = true; v.autoplay = true;
-        v.width = 640; v.height = 360;
-        v.crossOrigin = "anonymous";
-        v.style.display = "none";

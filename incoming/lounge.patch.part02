+function raceResizeCanvas() {
+  const cv = raceGame.canvas;
+  if (!cv) return;
+  const w = Math.min(1280, Math.max(640, window.innerWidth || 960));
+  const h = Math.min(720, Math.max(360, Math.floor((window.innerHeight || 600) * 0.72)));
+  if (cv.width !== w || cv.height !== h) { cv.width = w; cv.height = h; }

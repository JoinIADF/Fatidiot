-}
-function stopLoungeLiveTV() {
-  liveTV.active = false;
-  liveTV.audioTV = null;
-  liveTV.heldRemote = null;
-  for (const t of liveTV.tuners) {
-    t.playing = false;
-    clearTimeout(t.watchdog);
-    try { if (t.hls) { t.hls.destroy(); t.hls = null; } } catch (_) {}
-    try { t.video.muted = true; t.video.pause(); t.video.removeAttribute("src"); t.video.load(); } catch (_) {}
-  }
-  for (const r of liveTV.remotes) { r.held = false; try { r.mesh.visible = true; } catch (_) {} }
-  try { for (const s of getLoungeMediaScreens()) s.clear(); } catch (_) {}
-}
-function liveTVScreenWorldX(i) {
-  const scr = getLoungeMediaScreens()[i];
-  if (!scr) return 0;
-  const p = new THREE.Vector3();
-  scr.mesh.getWorldPosition(p);
-  return p;
-}
-function liveTVNearestTV(maxDist = 8) {
-  let best = null, bd = maxDist;
-  const screens = getLoungeMediaScreens();
-  for (let i = 0; i < screens.length; i++) {
-    const p = new THREE.Vector3();
-    screens[i].mesh.getWorldPosition(p);
-    const d = Math.hypot(pig.position.x - p.x, pig.position.z - p.z);
-    if (d < bd) { bd = d; best = i; }
-  }
-  return best;
-}
-function liveTVSetAudio(idx) {
-  liveTV.audioTV = idx;
-  for (const t of liveTV.tuners) t.video.muted = (t.idx !== idx);
-  if (idx != null) {
-    const t = liveTV.tuners[idx];
-    t.video.play().catch(() => {});
-    try { showMsg("\ud83d\udd0a TV-" + (idx + 1) + " (" + t.name + ") sound ON \u00b7 V again to mute \u00b7 mutes as you walk away"); } catch (_) {}
-  }
-}
-function updateLoungeLiveTV() {
-  if (!liveTV.active) return;
-  /* remote pickup by proximity */
-  for (const r of liveTV.remotes) {
-    if (r.held || !r.mesh.visible) continue;
-    const p = new THREE.Vector3();
-    r.mesh.getWorldPosition(p);
-    if (Math.hypot(pig.position.x - p.x, pig.position.z - p.z) < 1.5) {
-      /* return any held remote to the bar first */
-      if (liveTV.heldRemote != null) {
-        const old = liveTV.remotes[liveTV.heldRemote];
-        old.held = false; old.mesh.visible = true;
-      }
-      r.held = true;
-      r.mesh.visible = false;
-      liveTV.heldRemote = r.idx;
-      try { showMsg("\ud83d\udcfa Remote TV-" + (r.idx + 1) + " grabbed \u00b7 T: change channel \u00b7 C: captions \u00b7 V: sound"); } catch (_) {}
-      try { SFX.pickup(); } catch (_) {}
-    }
-  }
-  /* audio follows proximity: mute when you leave the TV you unmuted */
-  if (liveTV.audioTV != null) {
-    const p = new THREE.Vector3();
-    const scr = getLoungeMediaScreens()[liveTV.audioTV];
-    if (scr) {
-      scr.mesh.getWorldPosition(p);
-      if (Math.hypot(pig.position.x - p.x, pig.position.z - p.z) > 11) {
-        liveTVSetAudio(null);
-        try { showMsg("\ud83d\udd07 TV sound off (out of range)"); } catch (_) {}
-      }
-    }
-  }
-  /* paint frames ~20fps */
-  liveTV.frameSkip = (liveTV.frameSkip + 1) % 3;
-  if (liveTV.frameSkip) return;
-  const screens = getLoungeMediaScreens();
-  for (let i = 0; i < liveTV.tuners.length && i < screens.length; i++) {
-    const t = liveTV.tuners[i];
-    if (!t.playing) continue;
-    try {
-      screens[i].setMedia(liveTVDrawFrame(t));
-    } catch (e) {
-      t.playing = false;
-      liveTVTuneTV(i, false);
-    }
-  }
-}
-try {
-  window.__liveTV = liveTV;
-  window.__liveTVTune = liveTVTuneTV;
-} catch (_) {}

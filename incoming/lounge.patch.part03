-        v.addEventListener("playing", () => {
-          if (!liveTV.active) return;
-          t.playing = true;
-          t.hopCount = 0;
-          clearTimeout(t.watchdog);
-          /* audio-only trap: no video frames means useless on a screen */
-          setTimeout(() => {
-            if (liveTV.active && t.playing && v.videoWidth === 0 && !document.hidden) {
-              t.playing = false;
-              liveTVTuneTV(i, false);
-            }

+  if (code) opts.roomCode = code;
+
+  try {
+    await PR.insertCoin(opts);
+  } catch (err) {
+    MP.connecting = false;
+    const msg = (err && err.message) || String(err);
+    if (/ROOM_LIMIT|full|limit/i.test(msg)) throw new Error("Room is full (max 30 guests)");
+    throw new Error(msg || "Could not join room");
+  }
+
+  const me = PR.myPlayer();
+  me.setState("displayName", MP.displayName, true);
+  me.setState("role", "guest", true);
+  me.setState("verified", false, true);
+  me.setState("x", 0, true);
+  me.setState("z", 10, true);
+  me.setState("yaw", Math.PI, true);
+
+  try {
+    if (PR.RPC && PR.RPC.register) {
+      PR.RPC.register("loungeChat", async (payload, sender) => {
+        if (!payload || !payload.text) return;
+        mpPushChat({
+          id: sender && sender.id,
+          name: (payload.name) || mpNameOf(sender),
+          text: String(payload.text).slice(0, 200),
+          t: payload.t || Date.now(),
+        });
+      });
+    }
+  } catch (err) { console.warn("rpc register", err); }
+
+  PR.onPlayerJoin((player) => {
+    mpSpawnRemote(player);
+    /* late join: send recent chat snapshot if host */
+    try {
+      if (PR.isHost && PR.isHost() && player.id !== me.id) {
+        /* chat log is in room state */
+      }
+    } catch (_) {}
+  });
+
+  /* seed remotes already present */
+  try {
+    const parts = PR.getParticipants ? PR.getParticipants() : {};
+    for (const id of Object.keys(parts)) {
+      if (id !== me.id) mpSpawnRemote(parts[id]);
+    }
+  } catch (_) {}
+
+  /* hydrate chat from host log */
+  try {
+    const log = PR.getState("chatLog");
+    if (Array.isArray(log)) {
+      for (const m of log.slice(-40)) mpPushChat(m);
+    }
+  } catch (_) {}
+
+  MP.active = true;
+  MP.connecting = false;
+  MP.isGuest = true;
+  MP.demoListOnly = true;
+  MP.roomCode = (PR.getRoomCode && PR.getRoomCode()) || code || "";
+  mpSetHudVisible(true);
+  mpUpdateRoomChip();
+  mpPushChat({ sys: true, name: "SYSTEM", text: "You joined as unverified guest · " + MP.displayName, t: Date.now() });
+  showMsg("MULTIPLAYER · room " + (MP.roomCode || "····") + " · max 30");
+}
+
+function mpStopSession() {
+  if (!MP.active && !MP.connecting) return;
+  try {
+    const PR = mpPR();
+    const me = PR && PR.myPlayer && PR.myPlayer();
+    if (me && me.leaveRoom) me.leaveRoom();
+  } catch (_) {}
+  mpClearRemotes();
+  MP.active = false;
+  MP.connecting = false;
+  MP.roomCode = "";
+  mpSetHudVisible(false);
+  document.body.classList.remove("mp-chat-focus");
+}
+
+function mpPublishLocal(dt) {
+  if (!MP.active) return;
+  const PR = mpPR();
+  if (!PR) return;
+  const me = PR.myPlayer();
+  if (!me) return;
+  MP.syncT += dt;
+  const reliable = MP.syncT >= 0.35;
+  if (MP.syncT < 0.05) return;
+  MP.syncT = reliable ? 0 : MP.syncT - 0.05;
+  try {
+    me.setState("x", +pig.position.x.toFixed(3), reliable);
+    me.setState("z", +pig.position.z.toFixed(3), reliable);
+    me.setState("y", +(pigY || 0).toFixed(3), reliable);
+    me.setState("yaw", +yaw.toFixed(3), reliable);
+    me.setState("seated", seated && seated.seat ? seated.seat.label : null, true);
+    let game = null;
+    if (typeof dartGame !== "undefined" && dartGame.active) game = "darts";
+    else if (typeof raceGame !== "undefined" && raceGame.active) game = "race";
+    else if (typeof triviaGame !== "undefined" && triviaGame.active) game = "trivia";
+    else if (typeof strikerGame !== "undefined" && strikerGame.active) game = "striker";
+    else if (typeof arcadeGame !== "undefined" && arcadeGame.active) game = "arcade";
+    me.setState("game", game, true);
+    me.setState("displayName", MP.displayName, false);
+  } catch (_) {}
+}
+
+function mpUpdateRemotes(dt) {
+  if (!MP.active) return;
+  for (const r of MP.remotes.values()) {
+    try {
+      const p = r.player;
+      const x = Number(p.getState("x"));
+      const z = Number(p.getState("z"));
+      const y = Number(p.getState("y"));
+      const ry = Number(p.getState("yaw"));
+      const seatedLabel = p.getState("seated");
+      const game = p.getState("game");
+      if (Number.isFinite(x) && Number.isFinite(z)) {
+        r.target.set(x, 0, z);
+      }
+      r.mesh.position.x += (r.target.x - r.mesh.position.x) * Math.min(1, dt * 10);
+      r.mesh.position.z += (r.target.z - r.mesh.position.z) * Math.min(1, dt * 10);
+      const wantY = seatedLabel ? 0.28 : (Number.isFinite(y) ? Math.max(0, y) * 0.01 : 0);
+      r.mesh.position.y += (wantY - r.mesh.position.y) * Math.min(1, dt * 8);
+      if (Number.isFinite(ry)) {
+        let dR = ry - r.mesh.rotation.y;
+        while (dR > Math.PI) dR -= Math.PI * 2;
+        while (dR < -Math.PI) dR += Math.PI * 2;
+        r.mesh.rotation.y += dR * Math.min(1, dt * 8);
+      }
+      /* name may change */
+      const nm = mpNameOf(p);
+      if (r.mesh.userData.nameTag && r._name !== nm) {
+        r._name = nm;
+        try {
+          r.mesh.remove(r.mesh.userData.nameTag);
+          const nameTag = textSprite(nm, { size: 34, color: "#7CFFB0", strokeW: 6, maxWidth: 0 });
+          nameTag.position.set(0, 2.58, 0);
+          nameTag.scale.multiplyScalar(0.55);
+          r.mesh.add(nameTag);
+          r.mesh.userData.nameTag = nameTag;
+        } catch (_) {}
+      }
+      /* floating game tag */
+      if (game && game !== r._game) {
+        r._game = game;
+        floatText(r.mesh.position.clone().add(new THREE.Vector3(0, 2.9, 0)), "▶ " + String(game).toUpperCase(), {
+          size: 28, color: "#8fd1ff", strokeW: 5, life: 0.9, worldScale: 0.55
+        }, 0.9);
+      } else if (!game) r._game = null;
+      r.mesh.traverse(o => { try { o.layers.set(1); } catch (_) {} });
+      r.mesh.visible = true;
+    } catch (_) {}
+  }
+  mpUpdateRoomChip();
+}
+
+function updateMultiplayer(dt) {
+  if (!MP.active) return;
+  mpPublishLocal(dt);
+  mpUpdateRemotes(dt);
+}
+
+function mpListIsDemoOnly() {
+  return !!(MP.active && MP.demoListOnly);
+}
+
+async function mpEnterFromModal() {
+  const nameEl = document.getElementById("mpName");
+  const roomEl = document.getElementById("mpRoom");
+  const err = document.getElementById("mpjErr");
+  const name = (nameEl && nameEl.value || "").trim();
+  if (!name || name.length < 2) {
+    if (err) err.textContent = "Pick a display name (2+ characters).";
+    return;
+  }
+  if (err) err.textContent = "Connecting…";
+  try {
+    /* enter lounge world first so scene exists */
+    if (typeof startGame === "function") {
+      startGame({ social: true, liveLounge: true, multiplayer: true });
+    } else if (typeof activateSocialLounge === "function") {
+      activateSocialLounge();
+    }
+    await mpStartSession({ name, roomCode: roomEl && roomEl.value });
+    mpCloseJoinModal();
+    if (err) err.textContent = "";
+  } catch (e) {
+    if (err) err.textContent = (e && e.message) || "Join failed";
+    console.error(e);
+  }
+}
+
+function wireMultiplayerUI() {
+  const go = document.getElementById("mpjGo");
+  const cancel = document.getElementById("mpjCancel");
+  const btn = document.getElementById("btnMpLounge");
+  if (btn) btn.addEventListener("click", (ev) => {
+    ev.preventDefault(); ev.stopPropagation();
+    mpOpenJoinModal();
+  });
+  if (cancel) cancel.addEventListener("click", () => mpCloseJoinModal());
+  if (go) go.addEventListener("click", () => { mpEnterFromModal(); });
+  for (const id of ["mpName", "mpRoom"]) {
+    const el = document.getElementById(id);
+    if (el) el.addEventListener("keydown", (e) => {
+  if (document.body.classList.contains("mp-chat-focus")) return;
+  if (e.target && (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA")) return;
+      if (e.key === "Enter") { e.preventDefault(); mpEnterFromModal(); }
+      e.stopPropagation();
+    });
+  }
+  const send = () => {
+    const inp = document.getElementById("mpChatInput");
+    if (!inp) return;
+    mpSendChat(inp.value);

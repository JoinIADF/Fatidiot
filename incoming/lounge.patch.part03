+function ensureDartUI() {
+  let bar = document.getElementById("dartPower");
+  if (!bar) {
+    bar = document.createElement("div");
+    bar.id = "dartPower";
+    bar.innerHTML = `
+      <div class="dp-label" id="dartTitle">DARTS</div>
+      <div class="dp-modes" id="dartModes">
+        <button type="button" class="dp-mode on" data-mode="201">201</button>
+        <button type="button" class="dp-mode" data-mode="cricket">Cricket</button>
+        <button type="button" class="dp-mode" data-mode="practice">Practice</button>
+      </div>
+      <div class="dp-track"><div class="dp-fill" id="dartPowerFill"></div></div>
+      <div class="dp-score" id="dartScoreLine"></div>
+      <div class="dp-hint" id="dartHint">Pick a mode · walk to oche</div>`;
+    document.body.appendChild(bar);
+    bar.querySelectorAll(".dp-mode").forEach(btn => {
+      btn.addEventListener("click", (ev) => {
+        ev.preventDefault(); ev.stopPropagation();
+        if (!dartGame.active) return;
+        bar.querySelectorAll(".dp-mode").forEach(b => b.classList.remove("on"));
+        btn.classList.add("on");
+        dartGame.mode = btn.getAttribute("data-mode") || "201";
+        resetDartMatch();
+      });
+    });
+  }
+  let hud = document.getElementById("dartHud");
+  if (!hud) {
+    hud = document.createElement("div");
+    hud.id = "dartHud";
+    document.body.appendChild(hud);
+  }
+  return bar;
+}
+function resetDartMatch() {
+  dartGame.total = 0;
+  dartGame.throwsLeft = dartGame.mode === "practice" ? 9 : 99;
+  dartGame.dartsThisTurn = 3;
+  dartGame.turnHits = [];
+  dartGame.score201 = 201;
+  dartGame.cricket = {
+    marks: { 15:0, 16:0, 17:0, 18:0, 19:0, 20:0, 25:0 },
+    points: 0,
+  };
+  for (const d of dartGame.darts) try { scene.remove(d); } catch (_) {}
+  dartGame.darts = [];
+  dartGame.flying = [];
+  updateDartHud();
+  showMsg(dartGame.mode === "201"

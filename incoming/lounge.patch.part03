+}
+function raceRender() {
+  const cv = raceGame.canvas, ctx = raceGame.ctx;
+  if (!cv || !ctx || !raceGame.segments.length) return;
+  const width = cv.width, height = cv.height;
+  const baseSeg = raceFindSegment(raceGame.position);
+  if (!baseSeg) return;
+  const camZ = raceGame.position;
+  /* follow player's x for camera */
+  const you = raceGame.racers.find(r => r.isYou) || raceGame.racers[0];
+  const playerX = you ? you.x : 0;
+  const maxy = height;
+  let x = 0, dx = 0;
+
+  /* sky + hills */
+  const g = ctx.createLinearGradient(0, 0, 0, height * 0.55);
+  g.addColorStop(0, "#1a3a6a"); g.addColorStop(0.55, "#4a90c8"); g.addColorStop(1, "#7ec8e8");
+  ctx.fillStyle = g;
+  ctx.fillRect(0, 0, width, height);
+  ctx.fillStyle = "#2d6a3e";
+  ctx.fillRect(0, height * 0.55, width, height * 0.45);
+
+  const startIdx = baseSeg.index;
+  for (let n = 0; n < raceGame.drawDist; n++) {
+    const seg = raceGame.segments[(startIdx + n) % raceGame.segments.length];
+    raceUtilProject(seg.p1, playerX * raceGame.roadW - x, raceGame.camH, camZ, raceGame.camDepth, width, height, raceGame.roadW);
+    raceUtilProject(seg.p2, playerX * raceGame.roadW - x - dx, raceGame.camH, camZ, raceGame.camDepth, width, height, raceGame.roadW);
+    x += dx;
+    dx += seg.curve;
+    if (seg.p1.camera.z <= raceGame.camDepth || seg.p2.screen.y >= maxy || seg.p2.screen.y >= seg.p1.screen.y) continue;
+    raceSegment(ctx, width, raceGame.lanes,
+      seg.p1.screen.x, seg.p1.screen.y, seg.p1.screen.w,
+      seg.p2.screen.x, seg.p2.screen.y, seg.p2.screen.w,
+      seg.color);
+  }
+
+  /* draw racers (far to near) sorted by z distance from camera */
+  const drawList = raceGame.racers.map(r => {
+    let rel = r.z - camZ;
+    if (rel < -raceGame.trackLength / 2) rel += raceGame.trackLength;
+    if (rel > raceGame.trackLength / 2) rel -= raceGame.trackLength;
+    return { r, rel };
+  }).filter(o => o.rel > -raceGame.segLen * 2 && o.rel < raceGame.segLen * raceGame.drawDist)
+    .sort((a, b) => b.rel - a.rel);
+
+  for (const { r, rel } of drawList) {
+    const seg = raceFindSegment(r.z);
+    if (!seg) continue;
+    /* approximate screen pos from segment projection */
+    const p = { world: { x: r.x * raceGame.roadW, y: seg.p1.world.y, z: r.z }, camera: {}, screen: {} };
+    raceUtilProject(p, playerX * raceGame.roadW, raceGame.camH, camZ, raceGame.camDepth, width, height, raceGame.roadW);
+    if (p.camera.z <= raceGame.camDepth) continue;
+    const scale = p.screen.scale * 2200;
+    if (scale < 0.08) continue;
+    raceDrawCar(ctx, p.screen.x, p.screen.y, Math.min(2.2, Math.max(0.15, scale)), r.color, r.name, 0);
+  }
+
+  /* speed stripe HUD bottom of canvas */
+  ctx.fillStyle = "rgba(0,0,0,0.45)";
+  ctx.fillRect(0, height - 36, width, 36);
+  ctx.fillStyle = "#8fd1ff";
+  ctx.font = "bold 14px system-ui";
+  ctx.textAlign = "left";
+  ctx.fillText("TIMELINE ARCADE · same-screen multiplayer", 12, height - 14);
+  ctx.textAlign = "right";
+  ctx.fillStyle = "#ffd94a";
+  ctx.fillText((raceGame.standings || []).slice(0, 4).join("  "), width - 12, height - 14);
 }
+try {
+  window.startRaceGame = startRaceGame;
+  window.endRaceGame = endRaceGame;
+} catch (_) {}
 

     const g = document.getElementById("mpGroupChat");
     if (g) { g.classList.add("hidden"); g.setAttribute("aria-hidden", "true"); }
   }
 }
+function mpOpenChatComposer() {
+  if (!MP.active) return;
+  const bar = document.getElementById("mpChatBar");
+  if (!bar) return;
+  bar.classList.remove("hidden");
+  bar.setAttribute("aria-hidden", "false");
+  document.body.classList.add("mp-chat-focus");
+  /* release movement keys so WASD doesn't keep walking while typing */
+  try {
+    if (typeof keys === "object" && keys) {
+      for (const k of Object.keys(keys)) keys[k] = false;
+    }
+  } catch (_) {}
+  const inp = document.getElementById("mpChatInput");
+  if (inp) setTimeout(() => { try { inp.focus(); } catch (_) {} }, 30);
+}
+function mpCloseChatComposer() {
+  const bar = document.getElementById("mpChatBar");
+  if (bar) {
+    bar.classList.add("hidden");
+    bar.setAttribute("aria-hidden", "true");
+  }
+  const inp = document.getElementById("mpChatInput");
+  if (inp) try { inp.blur(); } catch (_) {}
+  /* keep focus class if group chat still open */
+  const g = document.getElementById("mpGroupChat");
+  const groupOpen = g && !g.classList.contains("hidden");
+  if (!groupOpen) document.body.classList.remove("mp-chat-focus");
+}
 

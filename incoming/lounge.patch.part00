-/* ============================== LOUNGE LIVE TV ==============================
- * Real live TV on the bar media screens, fed by the iptv-org project
- * (https://github.com/iptv-org — public channel database + API).
- * - HLS playback via hls.js (lazy-loaded from CDN; Safari plays natively)
- * - A curated seed list starts fast; the full iptv-org streams API is fetched
- *   in the background to extend the channel pool
- * - Streams must be CORS-clean to run through hls.js + canvas textures, and
- *   many public feeds are geo-blocked or dead — so a watchdog auto-skips to
- *   the next channel until one actually plays. T = next channel.
- * - Nothing here can break the game: every step is wrapped, and on failure
- *   the screens simply stay on their idle art. */
-const liveTV = {
-  active: false, playing: false, video: null, hls: null,
-  pool: [], idx: -1, name: "", watchdog: 0, frameSkip: 0, chIdx: 0,
-};
-/* Known CORS-friendly public HLS feeds — fast path while the big list loads */
-const LIVE_TV_SEEDS = [
-  { name: "NASA TV", url: "https://ntv1.akamaized.net/hls/live/2014075/NASA-NTV1-HLS/master.m3u8" },
-  { name: "Red Bull TV", url: "https://rbmn-live.akamaized.net/hls/live/590964/BoRB-AT/master_928.m3u8" },
-  { name: "DW English", url: "https://dwamdstream102.akamaized.net/hls/live/2015525/dwstream102/index.m3u8" },
-  { name: "Al Jazeera English", url: "https://live-hls-web-aje.getaj.net/AJE/index.m3u8" },
-  { name: "France 24 English", url: "https://live.france24.com/hls/live/2037218-b/F24_EN_HI_HLS/master.m3u8" },
-  { name: "Tastemade", url: "https://tastemade-tastemade-1-eu.rakuten.wurl.tv/playlist.m3u8" },
-];
-function ensureHlsJs() {
-  return new Promise((resolve, reject) => {
-    if (window.Hls) { resolve(window.Hls); return; }
-    const sc = document.createElement("script");
-    sc.src = "https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js";
-    sc.onload = () => window.Hls ? resolve(window.Hls) : reject(new Error("hls.js loaded but no Hls global"));
-    sc.onerror = () => reject(new Error("hls.js CDN load failed"));
-    document.head.appendChild(sc);
-  });
-}
-async function extendPoolFromIptvOrg() {
-  try {
-    const ctrl = new AbortController();
-    const to = setTimeout(() => ctrl.abort(), 15000);
-    const res = await fetch("https://iptv-org.github.io/api/streams.json", { signal: ctrl.signal });
-    clearTimeout(to);
-    if (!res.ok) return;
-    const all = await res.json();
-    /* https-only, no special headers required, plain m3u8 */
-    const ok = all.filter(s =>
-      s && typeof s.url === "string" &&
-      s.url.startsWith("https://") &&
-      s.url.includes(".m3u8") &&
-      !s.user_agent && !s.referrer
-    );
-    /* shuffle and take a manageable sample */
-    for (let i = ok.length - 1; i > 0; i--) {
-      const j = (Math.random() * (i + 1)) | 0;
-      [ok[i], ok[j]] = [ok[j], ok[i]];
-    }
-    const extra = ok.slice(0, 200).map(s => ({ name: s.channel || "iptv-org channel", url: s.url }));
-    liveTV.pool = liveTV.pool.concat(extra);
-    console.log("liveTV: pool extended to", liveTV.pool.length, "channels via iptv-org");
-  } catch (e) {
-    console.warn("liveTV: iptv-org list unavailable, using seeds only", e && e.message);
-  }
-}
-function liveTVCaption(name) {
-  return (ctx2, w, h) => {
-    const v = liveTV.video;
-    ctx2.fillStyle = "#000"; ctx2.fillRect(0, 0, w, h);
-    if (v && v.readyState >= 2 && v.videoWidth) {
-      /* letterbox-fit the video */
-      const ar = v.videoWidth / v.videoHeight, tar = w / h;
-      let dw = w, dh = h, dx = 0, dy = 0;
-      if (ar > tar) { dh = w / ar; dy = (h - dh) / 2; } else { dw = h * ar; dx = (w - dw) / 2; }
-      ctx2.drawImage(v, dx, dy, dw, dh);
-    }
-    /* LIVE badge + channel name */
-    ctx2.fillStyle = "rgba(0,0,0,0.62)";
-    ctx2.fillRect(0, h - 34, w, 34);
-    ctx2.fillStyle = "#ff3b3b";
-    ctx2.beginPath(); ctx2.arc(20, h - 17, 7, 0, Math.PI * 2); ctx2.fill();
-    ctx2.fillStyle = "#fff";
-    ctx2.font = "bold 17px system-ui, sans-serif";
-    ctx2.textAlign = "left"; ctx2.textBaseline = "middle";
-    ctx2.fillText("LIVE · " + name, 36, h - 16);
-    ctx2.textAlign = "right";
-    ctx2.fillStyle = "#9ec4e0";
-    ctx2.font = "600 13px system-ui, sans-serif";
-    ctx2.fillText("[T] next channel", w - 12, h - 16);
-  };
-}
-function liveTVNext(manual = false) {
-  if (!liveTV.active || !liveTV.pool.length) return;
-  liveTV.playing = false;
-  liveTV.idx = (liveTV.idx + 1) % liveTV.pool.length;
-  const ch = liveTV.pool[liveTV.idx];
-  liveTV.name = ch.name;
-  if (manual) { try { showMsg("📺 TUNING: " + ch.name); } catch (_) {} }
-  const v = liveTV.video;
-  try { if (liveTV.hls) { liveTV.hls.destroy(); liveTV.hls = null; } } catch (_) {}

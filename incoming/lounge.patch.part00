--- a/index.html
+++ b/index.html
@@ -831,43 +831,46 @@
   }
   #loungeMobBar #guestChip.show,
   #loungeMobBar .lounge-focus.show { display: block; }
+  /* U-grid: top chip spans full width; bottom row is the U base of 4 actions */
   #loungeMobBar .lounge-btns {
-    display: flex;
-    gap: 8px;
-    justify-content: center;
-    flex-wrap: nowrap;
+    display: grid;
+    grid-template-columns: 1fr 1fr 1fr 1fr;
+    grid-template-areas:
+      "read remove like list";
+    gap: 6px;
     width: 100%;
   }
   #loungeMobBar .lmbtn {
-    flex: 1 1 0;
-    min-width: 72px;
-    min-height: 60px;
-    padding: 11px 12px;
+    min-width: 0;
+    min-height: 52px;
+    padding: 10px 6px;
     border-radius: 14px;
     border: 1.5px solid rgba(255,255,255,0.35);
-    background: rgba(16, 22, 34, 0.92);
-    color: #e8eef8;
+    background: rgba(16, 22, 34, 0.9);
+    color: #e8ecf4;
     font: 800 12px/1.15 system-ui, sans-serif;
-    touch-action: manipulation;
-    -webkit-user-select: none; user-select: none;
-    white-space: nowrap;
-    overflow: visible;
-    text-overflow: clip;
     cursor: pointer;

+
+  /* —— Multiplayer lounge —— */
+  #mpJoinModal {
+    position: fixed; inset: 0; z-index: 220; display: flex; align-items: center; justify-content: center;
+    background: rgba(4,6,12,0.82); pointer-events: auto;
+  }
+  #mpJoinModal.hidden { display: none !important; }
+  #mpJoinModal .mpj-card {
+    width: min(420px, 92vw); background: linear-gradient(165deg, #141a28, #0c1018);
+    border: 1px solid rgba(124,255,176,0.35); border-radius: 18px; padding: 22px 20px 18px;
+    box-shadow: 0 24px 60px rgba(0,0,0,0.55); color: #e8eef8; font-family: system-ui, sans-serif;
+  }
+  #mpJoinModal h2 { font: 800 20px/1.2 system-ui; margin: 0 0 6px; color: #7CFFB0; letter-spacing: 0.04em; }
+  #mpJoinModal .mpj-sub { font: 600 13px/1.4 system-ui; color: #8b98a8; margin-bottom: 14px; }
+  #mpJoinModal label { display: block; font: 700 11px/1 system-ui; color: #8fd1ff; letter-spacing: 0.08em; margin: 10px 0 6px; text-transform: uppercase; }
+  #mpJoinModal input {
+    width: 100%; box-sizing: border-box; padding: 12px 14px; border-radius: 10px;
+    border: 1px solid #2a3548; background: #0a0e16; color: #e8eef8; font: 600 15px system-ui;
+  }
+  #mpJoinModal input:focus { outline: none; border-color: #7CFFB0; }
+  #mpJoinModal .mpj-actions { display: flex; gap: 10px; margin-top: 16px; }
+  #mpJoinModal .mpj-actions button {
+    flex: 1; padding: 12px; border-radius: 10px; border: 2px solid #3a4558;
+    background: #141a24; color: #e8eef8; font: 800 13px system-ui; cursor: pointer;
+  }
+  #mpJoinModal .mpj-actions button.primary { border-color: #7CFFB0; color: #7CFFB0; background: rgba(124,255,176,0.08); }
+  #mpJoinModal .mpj-err { color: #ff6a6a; font: 600 12px system-ui; min-height: 16px; margin-top: 8px; }
+  #mpJoinModal .mpj-badge {
+    display: inline-block; font: 700 10px system-ui; letter-spacing: 0.1em; text-transform: uppercase;
+    color: #ffd94a; border: 1px solid rgba(255,217,74,0.4); padding: 3px 8px; border-radius: 999px; margin-bottom: 10px;
+  }
+  #mpHud {
+    position: fixed; top: max(10px, env(safe-area-inset-top)); left: 50%; transform: translateX(-50%);
+    z-index: 90; pointer-events: none; display: flex; flex-direction: column; align-items: center; gap: 6px;
+  }
+  #mpHud.hidden { display: none !important; }
+  #mpRoomChip {
+    pointer-events: auto; background: rgba(10,14,22,0.88); border: 1px solid rgba(143,209,255,0.4);
+    color: #8fd1ff; font: 700 12px/1.2 system-ui; padding: 8px 14px; border-radius: 999px;
+    letter-spacing: 0.04em; cursor: pointer;
+  }
+  #mpRoomChip b { color: #7CFFB0; }
+  #mpChatDock {
+    position: fixed; left: 12px; bottom: max(120px, calc(env(safe-area-inset-bottom) + 100px));
+    z-index: 95; width: min(340px, 46vw); max-height: 28vh; overflow: hidden;
+    pointer-events: none; display: flex; flex-direction: column; gap: 4px;
+  }
+  #mpChatDock.hidden { display: none !important; }
+  #mpChatDock .mpc-line {
+    background: rgba(8,12,18,0.72); border-left: 3px solid #1d9bf0; padding: 6px 10px; border-radius: 0 8px 8px 0;
+    color: #e8eef8; font: 600 12px/1.35 system-ui; text-shadow: 0 1px 2px #000; animation: mpcIn 0.2s ease;
+  }
+  #mpChatDock .mpc-line .n { color: #7CFFB0; font-weight: 800; }
+  #mpChatDock .mpc-line.sys { border-left-color: #ffd94a; opacity: 0.9; }
+  @keyframes mpcIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
+  #mpChatBar {
+    position: fixed; left: 50%; transform: translateX(-50%);
+    bottom: max(18px, env(safe-area-inset-bottom)); z-index: 100;
+    display: flex; gap: 8px; align-items: center; width: min(520px, 94vw); pointer-events: auto;
+  }
+  #mpChatBar.hidden { display: none !important; }
+  #mpChatBar input {
+    flex: 1; padding: 12px 14px; border-radius: 12px; border: 1px solid #2a3548;
+    background: rgba(10,14,22,0.92); color: #e8eef8; font: 600 14px system-ui;
+  }
+  #mpChatBar input:focus { outline: none; border-color: #1d9bf0; }
+  #mpChatBar button {
+    padding: 12px 14px; border-radius: 12px; border: 1px solid #2a3548;
+    background: #141a24; color: #e8eef8; font: 800 12px system-ui; cursor: pointer; white-space: nowrap;
+  }
+  #mpChatBar button.primary { border-color: #1d9bf0; color: #8fd1ff; }
+  #mpChatBar button.group { border-color: #d48cff; color: #d48cff; }
+  #mpGroupChat {
+    position: fixed; right: 12px; top: max(56px, env(safe-area-inset-top));
+    z-index: 110; width: min(360px, 92vw); height: min(52vh, 480px);
+    background: linear-gradient(180deg, #121820, #0a0e14); border: 1px solid rgba(212,140,255,0.4);
+    border-radius: 16px; display: flex; flex-direction: column; overflow: hidden;
+    box-shadow: 0 18px 50px rgba(0,0,0,0.5); font-family: system-ui, sans-serif; pointer-events: auto;
+  }
+  #mpGroupChat.hidden { display: none !important; }
+  #mpGroupChat .mpg-head {
+    display: flex; align-items: center; justify-content: space-between; gap: 8px;
+    padding: 12px 14px; border-bottom: 1px solid #1e2838; background: rgba(212,140,255,0.08);
+  }
+  #mpGroupChat .mpg-head h3 { margin: 0; font: 800 14px system-ui; color: #d48cff; letter-spacing: 0.06em; }
+  #mpGroupChat .mpg-head span { font: 600 11px system-ui; color: #8b98a8; }
+  #mpGroupChat .mpg-close {
+    border: 0; background: transparent; color: #8b98a8; font: 800 16px system-ui; cursor: pointer;
+  }
+  #mpGroupChat .mpg-log {
+    flex: 1; overflow-y: auto; padding: 10px 12px; display: flex; flex-direction: column; gap: 8px;
+  }
+  #mpGroupChat .mpg-msg {
+    background: rgba(255,255,255,0.04); border-radius: 10px; padding: 8px 10px;
+  }
+  #mpGroupChat .mpg-msg .who { font: 800 12px system-ui; color: #7CFFB0; }
+  #mpGroupChat .mpg-msg .who.me { color: #8fd1ff; }
+  #mpGroupChat .mpg-msg .txt { font: 600 13px/1.4 system-ui; color: #e8eef8; margin-top: 2px; word-break: break-word; }
+  #mpGroupChat .mpg-msg .t { font: 600 10px system-ui; color: #5a6578; margin-top: 4px; }
+  #mpGroupChat .mpg-foot {
+    display: flex; gap: 8px; padding: 10px; border-top: 1px solid #1e2838;
+  }
+  #mpGroupChat .mpg-foot input {
+    flex: 1; padding: 10px 12px; border-radius: 10px; border: 1px solid #2a3548;
+    background: #0a0e16; color: #e8eef8; font: 600 13px system-ui;
+  }
+  #mpGroupChat .mpg-foot button {
+    padding: 10px 14px; border-radius: 10px; border: 1px solid #d48cff;
+    background: rgba(212,140,255,0.12); color: #d48cff; font: 800 12px system-ui; cursor: pointer;
+  }
+  body.mp-chat-focus #loungeMobBar,
+  body.mp-chat-focus #mobileUI { pointer-events: none; opacity: 0.35; }
+  #overlay .modeBtn.mp { border-color: #d48cff; color: #d48cff; }
+
 </style>

+function raceUtilIncrease(start, inc, max) {
+  let r = start + inc;
+  while (r >= max) r -= max;
+  while (r < 0) r += max;
+  return r;
+}
+function raceUtilLimit(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
+function raceUtilAccel(v, a, dt) { return v + a * dt; }
+function raceUtilProject(p, camX, camY, camZ, camDepth, w, h, roadW) {
+  p.camera.x = (p.world.x || 0) - camX;
+  p.camera.y = (p.world.y || 0) - camY;
+  p.camera.z = (p.world.z || 0) - camZ;
+  if (p.camera.z <= 1) { p.screen.scale = 0; p.screen.x = 0; p.screen.y = 0; p.screen.w = 0; return; }
+  p.screen.scale = camDepth / p.camera.z;
+  p.screen.x = Math.round(w / 2 + p.screen.scale * p.camera.x * w / 2);
+  p.screen.y = Math.round(h / 2 - p.screen.scale * p.camera.y * h / 2);
+  p.screen.w = Math.round(p.screen.scale * roadW * w / 2);
+}
+function raceFindSegment(z) {
+  const segs = raceGame.segments;
+  if (!segs.length) return null;
+  return segs[Math.floor(z / raceGame.segLen) % segs.length];
+}

-  clearTimeout(liveTV.watchdog);
-  const watchdogTick = () => {
-    if (document.hidden) { /* bg tabs pause video-only media — retune when visible */
-      liveTV.watchdog = setTimeout(watchdogTick, 4000);
-      return;
-    }
-    if (liveTV.active && !liveTV.playing) liveTVNext();
-  };
-  liveTV.watchdog = setTimeout(watchdogTick, 9000);
-  try {
-    if (v.canPlayType("application/vnd.apple.mpegurl")) {
-      v.src = ch.url;
-      v.play().catch(() => {});
-    } else if (window.Hls && window.Hls.isSupported()) {
-      const h = new window.Hls({ enableWorker: true, maxBufferLength: 12, capLevelToPlayerSize: true });
-      liveTV.hls = h;
-      h.on(window.Hls.Events.ERROR, (_ev, data) => {
-        if (data && data.fatal && liveTV.active && !liveTV.playing) {

+/* —— X PFP → guest face ——
+   Live feed supplies avatarUrl / profile_image_url; demo falls back to unavatar.io
+   (twitter/{handle}). Circular crop; letter disc stays until the image lands. */
+const _pfpTexCache = new Map(); /* url -> THREE.Texture */
+function pfpUrlCandidates(u) {
+  const handle = String((u && (u.handle || u.username)) || "").replace(/^@/, "").trim();
+  const urls = [];
+  const push = (v) => {
+    if (!v || typeof v !== "string") return;
+    const s = v.trim();
+    if (!s || urls.includes(s)) return;
+    urls.push(s);
+  };
+  push(u && (u.avatarUrl || u.profile_image_url || u.profileImageUrl || u.avatar));
+  /* X API often returns _normal — prefer higher res */
+  const raw = u && (u.avatarUrl || u.profile_image_url);
+  if (raw && /_normal\.(jpg|png|webp)/i.test(raw)) {
+    push(raw.replace(/_normal\.(jpg|png|webp)/i, ".$1"));
+    push(raw.replace(/_normal\.(jpg|png|webp)/i, "_400x400.$1"));
+  }
+  if (handle) {
+    push("https://unavatar.io/twitter/" + encodeURIComponent(handle) + "?fallback=false");
+    push("https://unavatar.io/x/" + encodeURIComponent(handle) + "?fallback=false");
+    /* CORS-friendly image proxy as last resort for pbs.twimg */
+    push("https://images.weserv.nl/?url=" + encodeURIComponent("unavatar.io/twitter/" + handle) + "&w=256&h=256&fit=cover&a=focal");
+  }
+  return urls;
+}
+function circleCropToTexture(img) {
+  const size = 256;
+  const c = document.createElement("canvas");
+  c.width = c.height = size;
+  const ctx = c.getContext("2d");
+  ctx.clearRect(0, 0, size, size);
+  ctx.beginPath();
+  ctx.arc(size / 2, size / 2, size / 2 - 1, 0, Math.PI * 2);
+  ctx.closePath();
+  ctx.clip();
+  const sw = img.naturalWidth || img.width;
+  const sh = img.naturalHeight || img.height;
+  const side = Math.min(sw, sh);
+  const sx = (sw - side) / 2;
+  const sy = (sh - side) / 2;
+  ctx.drawImage(img, sx, sy, side, side, 0, 0, size, size);
+  /* subtle rim so face reads on dark lounge */
+  ctx.beginPath();
+  ctx.arc(size / 2, size / 2, size / 2 - 2, 0, Math.PI * 2);
+  ctx.strokeStyle = "rgba(255,255,255,0.35)";
+  ctx.lineWidth = 6;
+  ctx.stroke();
+  const tex = new THREE.CanvasTexture(c);
+  tex.colorSpace = THREE.SRGBColorSpace;
+  tex.anisotropy = 4;
+  tex.needsUpdate = true;
+  return tex;
+}
+function loadPfpTexture(url) {
+  if (!url) return Promise.reject(new Error("no url"));
+  if (_pfpTexCache.has(url)) return Promise.resolve(_pfpTexCache.get(url));
+  return new Promise((resolve, reject) => {
+    const img = new Image();
+    img.crossOrigin = "anonymous";
+    img.onload = () => {
+      try {
+        const tex = circleCropToTexture(img);
+        _pfpTexCache.set(url, tex);
+        resolve(tex);
+      } catch (err) { reject(err); }
+    };
+    img.onerror = () => reject(new Error("pfp load fail " + url));
+    img.src = url;
+  });
+}
+async function applyPfpToFaceMesh(faceMesh, u) {
+  if (!faceMesh || !faceMesh.material) return false;
+  const candidates = pfpUrlCandidates(u);
+  for (const url of candidates) {
+    try {
+      const tex = await loadPfpTexture(url);
+      if (!faceMesh.material) return false;
+      /* dispose old letter map if present */
+      try {
+        const old = faceMesh.material.map;
+        if (old && old !== tex && old.image && old.image.tagName === "CANVAS" && !old.userData?.isPfp) {
+          /* keep letter textures cheap; only dispose if we know it's safe */
+        }
+      } catch (_) {}
+      tex.userData = tex.userData || {};
+      tex.userData.isPfp = true;
+      faceMesh.material.map = tex;
+      faceMesh.material.color.setHex(0xffffff);
+      faceMesh.material.transparent = true;
+      faceMesh.material.toneMapped = false;
+      faceMesh.material.needsUpdate = true;
+      faceMesh.userData.pfpUrl = url;
+      faceMesh.userData.hasPfp = true;
+      return true;
+    } catch (_) { /* try next candidate */ }
+  }
+  return false;
+}
+
 function buildXUser(u) {
   const g = new THREE.Group();
   const col = new THREE.Color(u.color || "#1d9bf0");
